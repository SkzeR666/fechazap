{
  "name": "fechazap-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js}\" \"tests/**/*.{ts,js}\" \"cloudflare/**/*.js\" \"*.{json,ts,md}\" \"docs/**/*.md\" .env.example",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js}\" \"tests/**/*.{ts,js}\" \"cloudflare/**/*.js\" \"*.{json,ts,md}\" \"docs/**/*.md\" .env.example",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "cf:deploy:files": "wrangler deploy --config cloudflare/files-worker/wrangler.toml"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.8.0",
    "@remixicon/react": "^4.9.0",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.49.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.26",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.18.3",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.27.0",
    "prettier": "^3.9.6",
    "supabase": "^2.23.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.4"
  }
}
