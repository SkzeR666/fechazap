{
  "name": "fechazap-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js}\" \"tests/**/*.{ts,js}\" \"cloudflare/**/*.js\" \"*.{json,ts,md}\" \"docs/**/*.md\" .env.example",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js}\" \"tests/**/*.{ts,js}\" \"cloudflare/**/*.js\" \"*.{json,ts,md}\" \"docs/**/*.md\" .env.example",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "cf:deploy:files": "wrangler deploy --config cloudflare/files-worker/wrangler.toml"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.3",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.27.0",
    "prettier": "^3.9.6",
    "supabase": "^2.23.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.4"
  }
}
